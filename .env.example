# Скопировать в .env и заполнить. Файл .env в git не попадает.

# Токен от @BotFather
BOT_TOKEN=123456:replace-me

# Whisper: tiny / base / small / medium / large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru
WHISPER_BEAM_SIZE=5

# Классификатор: tfidf (обученный baseline) или stub (заглушка без модели)
CLASSIFIER_BACKEND=tfidf
CLASSIFIER_MODEL_PATH=ml/models/text_baseline.joblib
MIN_CONFIDENCE=0.0

MAX_DURATION_SEC=300
MAX_FILE_SIZE_MB=20
MAX_CONCURRENT_JOBS=1
LOG_LEVEL=INFO
